{
  "name": "wedding-hall",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:integration:neon": "vitest run --config vitest.integration.neon.config.mts",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d --wait",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed-dev.ts",
    "setup-venue": "tsx scripts/setup-venue.ts",
    "support:remove-owner": "tsx scripts/remove-owner.ts",
    "support:reset-owner-password": "tsx scripts/reset-owner-password.ts",
    "db:info": "tsx scripts/db-info.ts",
    "env:check": "tsx scripts/env-check.ts",
    "cf:build": "tsx scripts/check-bundle-env.ts && opennextjs-cloudflare build && tsx scripts/check-bundle-env.ts --after-build",
    "preview": "npm run cf:build && opennextjs-cloudflare preview",
    "deploy": "npm run cf:build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@phi-ag/argon2": "0.6.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.12",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "shadcn": "^4.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "engines": {
    "node": ">=22"
  }
}
