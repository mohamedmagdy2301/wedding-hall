# Names only — never commit real values.
#
# WHERE EACH VALUE GOES
# - .env.secrets.local  → real secrets used by scripts (migrate, db:info, env:check, Neon tests).
#                         Next.js/OpenNext never read this file, so it is never bundled.
# - Worker secrets      → runtime secrets of the deployed app: `npx wrangler secret put <NAME>`.
# - .env.local / .env.development.local → local, non-secret values only (e.g. the docker database).
#   OpenNext embeds every Next.js env file into the Worker bundle; `npm run cf:build` refuses to
#   build if one of them contains a secret.

# App database connection (Neon: the *pooled* connection string). Worker secret + .env.secrets.local.
# Local docker: postgres://postgres:postgres@localhost:54329/wedding_hall_dev
DATABASE_URL=

# Direct (unpooled) connection string, used only by migrations and scripts. .env.secrets.local.
DATABASE_URL_UNPOOLED=

# Local only: host:port of the Neon wsproxy from docker compose (e.g. localhost:54330).
# Leave empty when connecting to a real Neon database.
NEON_LOCAL_WSPROXY=

# Integration tests database (local docker). Optional; defaults to the docker compose database.
TEST_DATABASE_URL=
