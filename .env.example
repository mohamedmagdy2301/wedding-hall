# Copy to .env.local and fill in. Never commit real values.

# App database connection (Neon: use the *pooled* connection string).
# Local default (docker compose): postgres://postgres:postgres@localhost:54329/wedding_hall_dev
DATABASE_URL=

# Direct (unpooled) connection string, used only by migrations.
DATABASE_URL_UNPOOLED=

# Local only: host:port of the Neon wsproxy from docker compose (e.g. localhost:54330).
# Leave empty when connecting to a real Neon database.
NEON_LOCAL_WSPROXY=

# Integration tests database (local docker). Optional; defaults to the docker compose database.
TEST_DATABASE_URL=
